# Local Ollama (default for Phase 1.1 development)
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
# Community GGUF of Apertus-8B-Instruct (Q4_K_M, ~5.1 GB)
# ollama pull MichelRosselli/apertus:8b-instruct-2509-q4_k_m
MODEL=MichelRosselli/apertus:8b-instruct-2509-q4_k_m

# Tool-calling debug (Apertus GGUF often ignores native tool_calls):
# ollama pull llama3.2:3b
# MODEL=llama3.2:3b
# Or one-shot: MODEL=llama3.2:3b pixi run agent-mock

# Optional: judge model (defaults to MODEL if unset)
# JUDGE_MODEL=MichelRosselli/apertus:8b-instruct-2509-q4_k_m
# JUDGE_TEMPERATURE=0

# Optional
TEMPERATURE=0
OPENAI_TIMEOUT_S=300

# run_python Docker sandbox (auto-starts Desktop/Colima + builds image if missing).
# No local-process fallback — Docker is required.
# DMATH_PYTHON_SANDBOX_IMAGE=dmath-python-sandbox:latest
# DMATH_PYTHON_SANDBOX_TIMEOUT_S=15
# DMATH_PYTHON_SANDBOX_DOCKER_START_TIMEOUT_S=120
# DMATH_PYTHON_SANDBOX_MEMORY=256m
# DMATH_PYTHON_SANDBOX_CPUS=1
# DMATH_PYTHON_SANDBOX_PIDS_LIMIT=64
# DMATH_PYTHON_SANDBOX_MAX_OUTPUT=12000

# --- CSCS Inference API (option A later; same client, swap these) ---
# OPENAI_BASE_URL=https://api.inference.cscs.ch/v1
# OPENAI_API_KEY=<CSCS_INFERENCE_API_KEY>
# MODEL=swiss-ai/Apertus-v1.5-8B
# JUDGE_MODEL=swiss-ai/Apertus-v1.5-70B
