# Local Ollama (default for Phase 1.1 development)
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
# Pull a quantized Apertus 8B instruct build into Ollama, then set MODEL to that tag.
# Download ~5 GB; runtime ~6 GB unified memory (comfortable on 16 GB Mac).
MODEL=apertus:8b

# Optional
TEMPERATURE=0
OPENAI_TIMEOUT_S=120

# --- CSCS Inference API (option A later; same client, swap these) ---
# OPENAI_BASE_URL=https://api.inference.cscs.ch/v1
# OPENAI_API_KEY=<CSCS_INFERENCE_API_KEY>
# MODEL=swiss-ai/Apertus-v1.5-8B
